{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnipChat",
  "version": "0.1.0",
  "identifier": "com.iamsamyiok.snipchat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SnipChat · 截屏助手",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": {
      "default": "icons/icon.ico"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}